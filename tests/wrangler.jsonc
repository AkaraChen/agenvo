{
  "name": "siyin-test",
  "main": "integration/entry.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "SiyinRelay" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiyinRelay"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": {
    "ORIGIN": "https://siyin.test",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
  },
}
