[Unit]
Description=Agenvo runtime relay
After=network-online.target
Wants=network-online.target

[Service]
User=agenvo
Group=agenvo
WorkingDirectory=/opt/agenvo
ExecStart=/usr/bin/node /opt/agenvo/dist/cli.js relay serve --config /etc/agenvo/relay.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agenvo

[Install]
WantedBy=multi-user.target
